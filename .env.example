# 動物眼睛量測 Pipeline 環境變數範例
# 複製為 .env 後依環境調整（.env 已被 .gitignore 忽略）

# COCO 資料集路徑（影像 + annotations JSON）
COCO_DIR=data/coco

# YOLO11-seg 模型權重（本地檔或 ultralytics 名稱，如 yolo11n-seg.pt）
YOLO_WEIGHTS=yolo11n-seg.pt

# 輸出目錄
OUTPUT_DIR=outputs

# 篩選門檻：每張圖最少動物數（含以上）
MIN_ANIMALS=2

# 分割信心閾值
CONF_THRESHOLD=0.25

# 隨機種子（決定性）
SEED=42

# 是否啟用 SAM2 眼睛精修（true/false，預設 false）
USE_SAM2=false

# 比例尺（實際長度/像素）；留空則以像素為單位
SCALE=
